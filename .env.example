# Copy this file to .env before starting the Full deployment.
# Every value below is a placeholder. Generate independent random values locally.

AUTH_DB_PASSWORD=replace-with-random-auth-db-password
TEACHER_DB_PASSWORD=replace-with-random-teacher-db-password
LITELLM_DB_PASSWORD=replace-with-random-litellm-db-password

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AI_TEACHER_INTERNAL_TOKEN=replace-with-random-internal-token
AI_TEACHER_TOOL_TOKEN=replace-with-a-different-random-tool-token

LITELLM_MASTER_KEY=replace-with-random-litellm-master-key
LITELLM_SALT_KEY=replace-with-stable-random-litellm-salt
LITELLM_CONFIG_PATH=./config/litellm/config.example.yaml
PROVIDER_API_BASE=https://api.openai.com/v1
PROVIDER_API_KEY=replace-with-provider-key
PROVIDER_MODEL=openai/gpt-4.1-mini
AI_TEACHER_MODEL=ai-teacher-fast
AI_TEACHER_PROVIDER=litellm-compatible
AI_TEACHER_REAL_LLM_ENABLED=true
AI_TEACHER_BASE_URL=http://litellm:4000/v1
AI_TEACHER_API_KEY=
AI_TEACHER_REQUIRE_ACTIVE_BUNDLE=false

AUTH_REGISTRATION_ENABLED=true
AUTH_GUEST_LOGIN_ENABLED=true
AI_TEACHER_RAG_TENANT_ID=public-local

WEB_PORT=3000
API_PORT=8080
TEACHER_PORT=7070
VALIDATOR_PORT=9090
